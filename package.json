{
  "name": "blend-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file offline viewer for Blender .blend files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "fzstd": "0.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
